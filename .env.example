# ==============================================================================
# ConceptCards Environment Variables (.env.example)
# Copy to .env for local development. Never commit real credentials.
# ==============================================================================

# Server configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or local MongoDB instance)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/conceptcards?retryWrites=true&w=majority
# If a localhost URI is unreachable in development, an embedded MongoDB starts automatically.
MONGODB_URI=mongodb://localhost:27017/conceptcards

# Optional: database name used when MONGODB_URI does not include one (default: conceptcards)
# MONGODB_DB_NAME=conceptcards

# Optional: DNS servers used for mongodb+srv:// lookups if the system resolver fails
# ("querySrv ECONNREFUSED"). Defaults to 8.8.8.8,1.1.1.1,8.8.4.4 when needed.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Authentication Security
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Client URL (for CORS allowance)
CLIENT_URL=http://localhost:5173
